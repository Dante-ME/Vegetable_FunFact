# Base URL the text-generation model is served from. Must end with a slash.
#
# Leave unset for local development: it defaults to '/models/', i.e. the same
# origin serving the app, which `npm run fetch-model` populates into
# public/models/. No account or external service needed to run locally.
#
# Set this for deployment when the model is hosted on a CDN rather than
# alongside the app. The bucket must:
#   1. serve the files with `Access-Control-Allow-Origin` covering the app's
#      origin (not needed when same-origin), and
#   2. preserve the directory layout <host>/SmolLM2-135M-Instruct/<file>.
#
# VITE_MODEL_HOST=https://models.example.com/
